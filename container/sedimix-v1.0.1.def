Bootstrap: docker
From: ubuntu:22.04

%labels
    Author Jierui Xu
    Description "sedimix workflow with complete Kraken2 installation"
    Version 1.0.1
    Kraken2Version 2.1.3
    CentrifugeVersion 1.0.4

%files
    tests/smoke_test_classifiers.sh /opt/sedimix/tests/smoke_test_classifiers.sh
    rules/snakefile_sedimix /opt/sedimix/rules/snakefile_sedimix
    scripts/select_reads_from_kraken2.py /opt/sedimix/scripts/select_reads_from_kraken2.py
    scripts/select_reads_from_centrifuge.py /opt/sedimix/scripts/select_reads_from_centrifuge.py

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        bc \
        build-essential \
        ca-certificates \
        curl \
        cython3 \
        gawk \
        git \
        gzip \
        libbz2-dev \
        libcurl4-openssl-dev \
        libgsl-dev \
        liblzma-dev \
        libtool \
        pkg-config \
        perl \
        python3 \
        python3-dev \
        python3-pip \
        r-base \
        rsync \
        tar \
        unzip \
        wget \
        zlib1g-dev
    ln -sf /usr/bin/python3 /usr/bin/python
    rm -rf /var/lib/apt/lists/*

    # Preserve the original source-build approach while pinning Centrifuge.
    CENTRIFUGE_VERSION=1.0.4
    CENTRIFUGE_SHA256=929daed0f84739f7636cc1ea2757527e83373f107107ffeb5937a403ba5201bc
    curl --fail --location --retry 3 \
        --output /tmp/centrifuge.tar.gz \
        "https://github.com/DaehwanKimLab/centrifuge/archive/refs/tags/v${CENTRIFUGE_VERSION}.tar.gz"
    echo "${CENTRIFUGE_SHA256}  /tmp/centrifuge.tar.gz" | sha256sum --check --strict
    mkdir -p /tmp/centrifuge-src
    tar --extract --gzip --file /tmp/centrifuge.tar.gz \
        --strip-components=1 --directory /tmp/centrifuge-src
    make -C /tmp/centrifuge-src
    cp /tmp/centrifuge-src/centrifuge* /usr/local/bin/
    rm -rf /tmp/centrifuge-src /tmp/centrifuge.tar.gz

    # Keep the complete Kraken2 tree together. Its Perl wrappers locate
    # compiled helpers such as classify relative to their own directory.
    KRAKEN2_VERSION=2.1.3
    KRAKEN2_SHA256=5269fa14adfb02e38c2da2e605e909a432d76c680d73e2e0e80e27ccd04d7c69
    curl --fail --location --retry 3 \
        --output /tmp/kraken2.tar.gz \
        "https://github.com/DerrickWood/kraken2/archive/refs/tags/v${KRAKEN2_VERSION}.tar.gz"
    echo "${KRAKEN2_SHA256}  /tmp/kraken2.tar.gz" | sha256sum --check --strict
    mkdir -p /tmp/kraken2-src /opt/kraken2
    tar --extract --gzip --file /tmp/kraken2.tar.gz \
        --strip-components=1 --directory /tmp/kraken2-src
    (cd /tmp/kraken2-src && ./install_kraken2.sh /opt/kraken2)
    rm -rf /tmp/kraken2-src /tmp/kraken2.tar.gz

    git clone --depth 1 https://github.com/lh3/seqtk.git /tmp/seqtk
    make -C /tmp/seqtk
    cp /tmp/seqtk/seqtk /usr/local/bin/
    rm -rf /tmp/seqtk

    git clone --depth 1 https://github.com/lh3/bwa.git /tmp/bwa
    make -C /tmp/bwa
    cp /tmp/bwa/bwa /usr/local/bin/
    rm -rf /tmp/bwa

    wget -q https://github.com/samtools/samtools/releases/download/1.20/samtools-1.20.tar.bz2 -O /tmp/samtools.tar.bz2
    mkdir -p /tmp/samtools
    tar -xjf /tmp/samtools.tar.bz2 --strip-components=1 -C /tmp/samtools
    (cd /tmp/samtools && ./configure && make -j2 && make install)
    rm -rf /tmp/samtools /tmp/samtools.tar.bz2

    wget -q https://github.com/arq5x/bedtools2/releases/download/v2.29.1/bedtools-2.29.1.tar.gz -O /tmp/bedtools.tar.gz
    mkdir -p /tmp/bedtools
    tar -xzf /tmp/bedtools.tar.gz --strip-components=1 -C /tmp/bedtools
    make -C /tmp/bedtools -j2
    cp /tmp/bedtools/bin/bedtools /usr/local/bin/
    rm -rf /tmp/bedtools /tmp/bedtools.tar.gz

    git clone --depth 1 https://github.com/ginolhac/mapDamage.git /tmp/mapDamage
    pip3 install --no-cache-dir /tmp/mapDamage
    rm -rf /tmp/mapDamage

    pip3 install --no-cache-dir --upgrade pip setuptools wheel
    pip3 install --no-cache-dir \
        snakemake==7.32.4 \
        pysam \
        cython \
        numpy==1.24.4 \
        tqdm==4.66.1 \
        pandas==2.1.2 \
        pyfaidx==0.8.1.1 \
        biopython==1.84 \
        scipy==1.11.3 \
        'pulp<2.8.0'

    Rscript -e "install.packages(c('inline','gam','Rcpp','RcppGSL','ggplot2'), repos='https://cloud.r-project.org')"

    chmod 0755 /opt/sedimix/tests/smoke_test_classifiers.sh

    test -x /opt/kraken2/kraken2
    test -x /opt/kraken2/kraken2-build
    test -x /opt/kraken2/kraken2-inspect
    test -x /opt/kraken2/classify
    test -x /opt/kraken2/build_db
    test -x /opt/kraken2/k2
    test -x /opt/kraken2/estimate_capacity

%environment
    export PATH=/opt/kraken2:/usr/local/bin:$PATH
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%test
    set -eu
    command -v centrifuge
    command -v centrifuge-build
    command -v centrifuge-inspect
    command -v centrifuge-kreport
    command -v seqtk
    command -v bwa
    command -v samtools
    command -v bedtools
    command -v mapDamage
    command -v snakemake
    kraken2 --version 2>&1 | grep -q "Kraken version 2.1.3"
    snakemake --version
    python -c 'import Bio, numpy, pandas, pyfaidx, pysam, scipy, tqdm'
    Rscript -e 'library(inline); library(gam); library(Rcpp); library(RcppGSL); library(ggplot2)'
    /opt/sedimix/tests/smoke_test_classifiers.sh

%runscript
    exec snakemake "$@"

%help
    sedimix v1.0.1 runtime image.

    Kraken2 2.1.3 is installed under /opt/kraken2 with all wrapper scripts
    and compiled helper executables kept together. The embedded image test
    builds tiny Kraken2 and Centrifuge databases and runs both classifier
    branches of the sedimix workflow through classified FASTQ generation.
