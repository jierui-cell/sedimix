Bootstrap: docker
From: mambaorg/micromamba@sha256:0d2870c1159dfb0c285e1c942c68385cd1110255cc9551838a29e48793e21af1

%labels
    Author Jierui Xu
    Description "sedimix workflow with complete Kraken2 installation"
    Version 1.0.1
    Kraken2Version 2.1.3

%files
    tests/smoke_test_kraken2.sh /opt/sedimix/tests/smoke_test_kraken2.sh

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    export MAMBA_ROOT_PREFIX=/opt/conda

    apt-get update
    apt-get install -y --no-install-recommends \
        bc \
        build-essential \
        ca-certificates \
        curl \
        gawk \
        gzip \
        perl \
        rsync \
        tar \
        zlib1g-dev
    rm -rf /var/lib/apt/lists/*

    # Install the complete Kraken2 tree in one location. The Perl wrappers
    # resolve compiled helpers such as classify relative to this directory.
    KRAKEN2_VERSION=2.1.3
    KRAKEN2_SHA256=5269fa14adfb02e38c2da2e605e909a432d76c680d73e2e0e80e27ccd04d7c69
    curl --fail --location --retry 3 \
        --output /tmp/kraken2.tar.gz \
        "https://github.com/DerrickWood/kraken2/archive/refs/tags/v${KRAKEN2_VERSION}.tar.gz"
    echo "${KRAKEN2_SHA256}  /tmp/kraken2.tar.gz" | sha256sum --check --strict
    mkdir -p /tmp/kraken2-src /opt/kraken2
    tar --extract --gzip --file /tmp/kraken2.tar.gz \
        --strip-components=1 --directory /tmp/kraken2-src
    (cd /tmp/kraken2-src && ./install_kraken2.sh /opt/kraken2)
    rm -rf /tmp/kraken2-src /tmp/kraken2.tar.gz

    # Install the remaining pipeline dependencies into the base micromamba
    # environment. Kraken2 is intentionally source-installed above so its
    # wrappers and private compiled helpers cannot be split during packaging.
    micromamba install --yes --name base \
        --channel conda-forge \
        --channel bioconda \
        --strict-channel-priority \
        python=3.10 \
        snakemake=7.32.4 \
        'pulp<2.8' \
        pysam=0.22.1 \
        cython=3.0 \
        numpy=1.24.4 \
        tqdm=4.66.1 \
        pandas=2.1.2 \
        pyfaidx=0.8.1.1 \
        biopython=1.84 \
        scipy=1.11.3 \
        centrifuge=1.0.4_beta \
        seqtk=1.4 \
        bwa=0.7.17 \
        samtools=1.20 \
        bedtools=2.31.1 \
        mapdamage2=2.2.2 \
        r-base \
        r-inline \
        r-gam \
        r-rcpp \
        r-rcppgsl \
        r-ggplot2
    micromamba clean --all --yes

    chmod 0755 /opt/sedimix/tests/smoke_test_kraken2.sh

    test -x /opt/kraken2/kraken2
    test -x /opt/kraken2/kraken2-build
    test -x /opt/kraken2/kraken2-inspect
    test -x /opt/kraken2/classify
    test -x /opt/kraken2/build_db
    test -x /opt/kraken2/k2
    test -x /opt/kraken2/estimate_capacity

%environment
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=/opt/kraken2:/opt/conda/bin:$PATH
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%test
    set -eu
    command -v centrifuge
    command -v seqtk
    command -v bwa
    command -v samtools
    command -v bedtools
    command -v mapDamage
    command -v snakemake
    snakemake --version
    python -c 'import Bio, numpy, pandas, pyfaidx, pysam, scipy, tqdm'
    Rscript -e 'library(inline); library(gam); library(Rcpp); library(RcppGSL); library(ggplot2)'
    /opt/sedimix/tests/smoke_test_kraken2.sh

%runscript
    exec snakemake "$@"

%help
    sedimix v1.0.1 runtime image.

    Kraken2 2.1.3 is installed under /opt/kraken2 with all wrapper scripts
    and compiled helper executables kept together. Run the workflow by
    invoking Snakemake explicitly or through this image's runscript.
